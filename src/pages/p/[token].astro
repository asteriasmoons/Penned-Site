---
import ReaderPageBody from "../../components/publishing/ReaderPageBody.astro";
import { reader, presentPublication, publishingProject } from "../../lib/public-document.ts";
import type { PublishedPage } from "../../lib/publishing.ts";
import { publicationIdentifier, readerCookieName, ReaderAccessRequired, linkedPageKey } from "../../lib/publishing.ts";
import "../../styles/reader.css";

export const prerender = false;
if (Astro.url.hostname === "penned-site-pi.vercel.app") {
  return Astro.redirect("https://www.penned.im" + Astro.url.pathname + Astro.url.search, 308);
}
const token = Astro.params.token || "";
const pageKey = Astro.url.searchParams.get("page") || undefined;
let publication: PublishedPage | null = null;
let unavailable = false;
let gate: ReaderAccessRequired|null=null;
if (publicationIdentifier.test(token) && (pageKey == null || linkedPageKey.test(pageKey))) {
  try { publication = await reader.read(token, AbortSignal.timeout(15000),Astro.cookies.get(readerCookieName(token))?.value,pageKey,true); }
  catch(error) { if(error instanceof ReaderAccessRequired)gate=error;else unavailable = true; }
}
let presentation: ReturnType<typeof presentPublication> | null = null;
if (publication) {
  try { presentation = presentPublication(publication, token); }
  catch { publication = null; unavailable = true; }
}
const valid = Boolean(publication && presentation);
Astro.response.status = valid ? 200 : gate ? 401 : unavailable ? 503 : 404;
for (const [name, value] of Object.entries({
  "Cache-Control": "private, no-store, max-age=0", "CDN-Cache-Control": "no-store", "Vercel-CDN-Cache-Control": "no-store",
  "Referrer-Policy": "no-referrer", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY",
  "X-Robots-Tag": valid && publication?.settings.allowIndexing ? "index, follow" : "noindex, nofollow",
  "Content-Security-Policy": `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: ${new URL(publishingProject).origin} https://images.unsplash.com; media-src 'self' ${new URL(publishingProject).origin}; connect-src 'self' ${new URL(publishingProject).origin}; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'`,
})) Astro.response.headers.set(name, value);
if (unavailable) Astro.response.headers.set("Retry-After", "30");
const title = valid ? publication!.document.title || "Document" : gate ? "Protected Document" : unavailable ? "Could not load document" : "Document unavailable";
const snapshots=(publication?.snapshots||[]).map(snapshot=>({ ...snapshot, title:snapshot.publication.document.title||"Document", presentation:presentPublication(snapshot.publication,token) }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/viewer-assets/editor.css" />
    <title>{title} | Penned</title>
    <meta name="robots" content={publication?.settings.allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <meta property="og:site_name" content="Penned" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {valid && publication!.document.subtitle && <meta name="description" content={publication!.document.subtitle} />}
  </head>
  <body class="penned-reader" data-publication={valid ? token : undefined} data-page={valid ? pageKey : undefined} data-api={valid ? `/p/${token}/status${pageKey ? `?page=${pageKey}` : ""}` : undefined} data-version={publication?.version}
    data-expires={publication?.settings.expiresAt || undefined}>
    <ReaderPageBody publication={publication} presentation={presentation} token={token} pageKey={pageKey} title={title} unavailable={unavailable} gate={gate} retryURL={Astro.url.pathname+Astro.url.search} />
    {snapshots.map(snapshot=><template data-reader-snapshot data-page={snapshot.page||""} data-version={snapshot.publication.version} data-title={snapshot.title+" | Penned"} data-expires={snapshot.publication.settings.expiresAt||undefined} data-api={`/p/${token}/status${snapshot.page?`?page=${snapshot.page}`:""}`}>
      <ReaderPageBody publication={snapshot.publication} presentation={snapshot.presentation} token={token} pageKey={snapshot.page||undefined} title={snapshot.title} />
    </template>)}
    <script>import "../../scripts/public-reader.ts";</script>
  </body>
</html>
