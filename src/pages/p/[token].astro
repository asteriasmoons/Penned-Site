---
import ReaderIcon from "../../components/publishing/ReaderIcon.astro";
import { reader, presentPublication, photoCredit, publishingProject, iconURL } from "../../lib/public-document.ts";
import type { PublishedPage } from "../../lib/publishing.ts";
import { publicationIdentifier, readerCookieName, ReaderAccessRequired } from "../../lib/publishing.ts";
import ReaderGate from "../../components/publishing/ReaderGate.astro";
import "../../styles/reader.css";

export const prerender = false;
const token = Astro.params.token || "";
let publication: PublishedPage | null = null;
let unavailable = false;
let gate: ReaderAccessRequired|null=null;
if (publicationIdentifier.test(token)) {
  try { publication = await reader.read(token, AbortSignal.timeout(15000),Astro.cookies.get(readerCookieName(token))?.value); }
  catch(error) { if(error instanceof ReaderAccessRequired)gate=error;else unavailable = true; }
}
let presentation: ReturnType<typeof presentPublication> | null = null;
if (publication) {
  try { presentation = presentPublication(publication, token); }
  catch { publication = null; unavailable = true; }
}
const valid = Boolean(publication && presentation);
Astro.response.status = valid ? 200 : gate ? 401 : unavailable ? 503 : 404;
for (const [name, value] of Object.entries({
  "Cache-Control": "private, no-store, max-age=0", "CDN-Cache-Control": "no-store", "Vercel-CDN-Cache-Control": "no-store",
  "Referrer-Policy": "no-referrer", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY",
  "X-Robots-Tag": valid && publication?.settings.allowIndexing ? "index, follow" : "noindex, nofollow",
  "Content-Security-Policy": `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' ${new URL(publishingProject).origin} https://images.unsplash.com; media-src 'self' ${new URL(publishingProject).origin}; connect-src 'self' ${new URL(publishingProject).origin}; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'`,
})) Astro.response.headers.set(name, value);
if (unavailable) Astro.response.headers.set("Retry-After", "30");
const title = valid ? publication!.document.title || "Document" : gate ? "Protected Document" : unavailable ? "Could not load document" : "Document unavailable";
const toc = valid && publication!.settings.showTableOfContents ? presentation!.toc : [];
const coverCredit = presentation ? photoCredit(presentation.coverPhoto) : null;
const backdropCredit = presentation ? photoCredit(presentation.outer.photo) : null;
const paperCredit = presentation ? photoCredit(presentation.paper.photo) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/viewer-assets/editor.css" />
    <title>{title} | Penned</title>
    <meta name="robots" content={publication?.settings.allowIndexing ? "index, follow" : "noindex, nofollow"} />
    <meta property="og:site_name" content="Penned" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {valid && publication!.document.subtitle && <meta name="description" content={publication!.document.subtitle} />}
  </head>
  <body class="penned-reader" data-publication={valid ? token : undefined} data-api={valid ? `/p/${token}/status` : undefined} data-version={publication?.version}
    data-expires={publication?.settings.expiresAt || undefined}>
    <a class="reader-skip" href="#document">Skip to document</a>
    <header class="reader-header">
      <a class="reader-brand" href="/" aria-label="Penned homepage"><img src="/images/branding/penned.png" alt="" width="28" height="28" /><span>Penned</span></a>
      <span class="reader-header-title" data-reader-title>{valid ? title : ""}</span>
      <div class="reader-header-actions">
        {valid && <button class="reader-icon-button" type="button" data-open-search title="Search document" aria-label="Search document" aria-expanded="false" aria-controls="reader-search"><ReaderIcon name="searchwavy" /></button>}
        {toc.length > 0 && <button class="reader-icon-button reader-contents-button" type="button" data-open-contents title="Table of contents" aria-label="Table of contents" aria-expanded="false" aria-controls="reader-toc"><ReaderIcon name="bulletlist" /></button>}
      </div>
    </header>
    {valid && presentation && publication ? <>
      <div class="reader-backdrop" style={`background:${presentation.outer.css}`} data-blur={presentation.outer.blur} data-faded={presentation.outer.faded} aria-hidden="true"></div>
      {presentation.theme && presentation.theme !== "custom" && <div class="reader-theme-pattern" style={`--reader-pattern:url(${JSON.stringify(iconURL(presentation.theme === "lunarClouds" ? "rainbowclouds" : "codewindow"))})`} data-pattern={presentation.theme} data-faded={presentation.outer.faded} aria-hidden="true"></div>}
      <section id="reader-search" class="reader-search" aria-label="Search this document" hidden>
        <ReaderIcon name="searchwavy" />
        <input type="search" data-search-input aria-label="Search document text" autocomplete="off" placeholder="Search document" />
        <output class="reader-search-count" data-search-count aria-live="polite"></output>
        <button class="reader-icon-button" data-search-prev type="button" title="Previous result" aria-label="Previous result"><ReaderIcon name="chevup" /></button>
        <button class="reader-icon-button" data-search-next type="button" title="Next result" aria-label="Next result"><ReaderIcon name="chevdown" /></button>
        <button class="reader-icon-button" data-close-search type="button" title="Close search" aria-label="Close search"><ReaderIcon name="xmarkwavy" /></button>
      </section>
      <p class="reader-network-status" data-network-status role="status" hidden></p>
      <div class:list={["reader-layout", { "has-contents": toc.length > 0 }]} data-reader-layout>
        {toc.length > 0 && <aside class="reader-toc" id="reader-toc" aria-label="Table of contents">
          <div class="reader-toc-heading"><strong>Contents</strong><button class="reader-icon-button" type="button" data-close-contents title="Close contents" aria-label="Close contents"><ReaderIcon name="xmarkwavy" /></button></div>
          <nav>{toc.map(item => <a href={`#${item.id}`} style={`--heading-level:${Math.min(3, item.level)}`} data-toc-link>{item.text || "Untitled heading"}</a>)}</nav>
        </aside>}
        <main id="document" class="reader-document" tabindex="-1" aria-label={title}>
          {presentation.segments.map((html, index) => <article class="reader-paper penned-document" style={presentation!.styles} data-paper-blur={presentation!.paper.blur} data-paper-faded={presentation!.paper.faded} data-document-scheme={presentation!.light ? "light" : "dark"} aria-label={index ? `Page ${index + 1}` : title}>
            {index === 0 && <>
              {presentation!.showCover && <div class="reader-cover" data-cover-theme={presentation!.coverTheme}>
                {presentation!.cover ? <img src={presentation!.cover} alt="" fetchpriority="high" decoding="async" /> : <img class="reader-cover-art" src={iconURL(presentation!.coverTheme === "neonCode" ? "codewindow" : "moonzs")} alt="" />}
              </div>}
              {coverCredit && presentation!.showCover && <small class="reader-photo-credit">Photo by <a href={coverCredit.photographerURL} target="_blank" rel="noopener noreferrer">{coverCredit.name}</a> on <a href={coverCredit.sourceURL} target="_blank" rel="noopener noreferrer">Unsplash</a></small>}
              {(publication!.settings.showTitle !== false || publication!.document.subtitle || presentation!.author) && <header class="reader-document-heading">
                {publication!.settings.showTitle !== false && <div class="reader-title-row"><h1>{publication!.document.title || "Untitled"}</h1>{publication!.document.icon && <ReaderIcon name={publication!.document.icon} class="reader-document-icon" />}</div>}
                {publication!.document.subtitle && <p class="reader-subtitle">{publication!.document.subtitle}</p>}
                {presentation!.author && <p class="reader-author">{presentation!.author}</p>}
              </header>}
            </>}
            <div class="tiptap-editor reader-content" set:html={html}></div>
          </article>)}
          <footer class="reader-document-footer">{publication!.settings.showBranding!==false&&<a class="reader-footer-brand" href="/"><img src="/images/branding/penned.png" alt="" width="20" height="20" />Published with Penned</a>}
            {[backdropCredit, paperCredit].filter(Boolean).map(credit => <small class="reader-photo-credit">Photo by <a href={credit!.photographerURL} rel="noopener noreferrer" target="_blank">{credit!.name}</a> on <a href={credit!.sourceURL} rel="noopener noreferrer" target="_blank">Unsplash</a></small>)}
          </footer>
        </main>
      </div>
      <div class="reader-drawer-shade" data-drawer-shade hidden></div>
      <div class="reader-loading" data-reader-loading hidden role="status" aria-label="Opening document"><div class="reader-dot-spinner" aria-hidden="true">{Array.from({length:12}, (_, i) => <i style={`--dot:${i}`} />)}</div><span>Opening document</span></div>
      <dialog class="reader-media-dialog" data-media-dialog aria-label="Image viewer">
        <div class="reader-media-toolbar"><span data-media-name></span><span data-media-counter></span>
          <button class="reader-icon-button" type="button" data-media-prev aria-label="Previous image" title="Previous image"><ReaderIcon name="chevleft" /></button>
          <button class="reader-icon-button" type="button" data-media-next aria-label="Next image" title="Next image"><ReaderIcon name="chevright" /></button>
          <button class="reader-icon-button" type="button" data-media-zoom-out aria-label="Zoom out" title="Zoom out"><ReaderIcon name="minuswavy" /></button>
          <button class="reader-icon-button" type="button" data-media-zoom-in aria-label="Zoom in" title="Zoom in"><ReaderIcon name="addwavy" /></button>
          <a class="reader-icon-button" data-media-original target="_blank" rel="noopener noreferrer" aria-label="Open original image" title="Open original image"><ReaderIcon name="arrowin" /></a>
          <button class="reader-icon-button" type="button" data-media-close aria-label="Close image viewer" title="Close image viewer"><ReaderIcon name="xmarkwavy" /></button>
        </div>
        <div class="reader-media-viewport"><img data-media-image alt="" /></div>
      </dialog>
    </> : gate ? <ReaderGate password={gate.password} email={gate.email} token={token} /> : <main class="reader-state" id="document" tabindex="-1"><ReaderIcon name="linedpages" /><h1>{title}</h1>
      <p>{unavailable ? "Please try opening this document again." : "This link may have been unpublished, expired, or replaced."}</p>
      {unavailable && <a class="reader-retry" href={Astro.url.pathname}>Try Again</a>}
    </main>}
    <script>import "../../scripts/public-reader.ts";</script>
  </body>
</html>
