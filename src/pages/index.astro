---
import BaseLayout from "../layouts/BaseLayout.astro";

const icon = "/icons/sparkle.svg";

const features = [
  {
    label: "WRITE",
    title: "Make room for every idea.",
    description:
      "From your first thought to your finished document, Penned gives your words a beautiful place to grow.",
    href: "/product/write",
  },
  {
    label: "ORGANIZE",
    title: "Everything in its place.",
    description:
      "Bring your documents, projects, and ideas together in a workspace that feels entirely your own.",
    href: "/product/organize",
  },
  {
    label: "CUSTOMIZE",
    title: "Your documents. Your style.",
    description:
      "Shape the appearance of your writing with beautiful document styles and personalized formatting.",
    href: "/product/customize",
  },
];

const documents = [
  {
    title: "My Creative Space",
    category: "Creative Projects",
    date: "Today",
  },
  {
    title: "Daily Reflections",
    category: "Personal Notes",
    date: "Yesterday",
  },
  {
    title: "Ideas Worth Exploring",
    category: "Inspiration",
    date: "October 12",
  },
];

const collections = [
  {
    title: "Creative Projects",
    count: "12 documents",
    className: "collection-purple",
  },
  {
    title: "Personal Notes",
    count: "24 documents",
    className: "collection-pink",
  },
  {
    title: "Planning",
    count: "8 documents",
    className: "collection-lavender",
  },
  {
    title: "Inspiration",
    count: "16 documents",
    className: "collection-blue",
  },
];

const templates = [
  {
    category: "JOURNALING",
    title: "Daily Reflections",
    description: "A little space to gather your thoughts.",
    className: "template-lavender",
    lines: [
      "Today I'm grateful for...",
      "Something I learned...",
      "Tomorrow I want to...",
    ],
  },
  {
    category: "PLANNING",
    title: "Weekly Planner",
    description: "Give your week a beautiful beginning.",
    className: "template-pink",
    lines: [
      "Monday — Priorities",
      "Tuesday — In Progress",
      "Wednesday — Looking Ahead",
    ],
  },
  {
    category: "WRITING",
    title: "Creative Notes",
    description: "For ideas that deserve to become something.",
    className: "template-violet",
    lines: [
      "The beginning of an idea",
      "A thought worth exploring",
      "Where this could lead...",
    ],
  },
];
---

<BaseLayout
  title="Penned — Your Words. Your World."
  description="A beautiful space to write, create, organize, and personalize your documents. Discover a more expressive way to bring your ideas to life."
>
  <!-- ======================================================
       HERO
       ====================================================== -->

  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true"></div>

    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-eyebrow animate-fade-in">
          <img src={icon} alt="" aria-hidden="true" />
          <span>A NEW SPACE FOR YOUR IDEAS</span>
        </div>

        <h1 class="hero-title animate-slide-up">
          Your words.
          <span>Your world.</span>
        </h1>

        <p class="hero-description animate-slide-up">
          Beautiful documents. Endless possibilities. One thoughtfully designed
          space to bring everything you imagine to life.
        </p>

        <div class="hero-actions animate-slide-up">
          <a href="/download" class="button button-primary hero-button">
            Get Penned
            <img src={icon} alt="" aria-hidden="true" />
          </a>

          <a href="#discover" class="button hero-button-secondary">
            Explore Penned
          </a>
        </div>
      </div>

      <!-- PRODUCT SHOWCASE -->

      <div class="hero-showcase" data-reveal="up">
        <div class="showcase-glow" aria-hidden="true"></div>

        <div class="app-window">
          <!-- Application Header -->

          <div class="app-header">
            <div class="app-header-brand">
              <img
                src={icon}
                alt=""
                aria-hidden="true"
                class="app-brand-icon"
              />

              <span>My Workspace</span>
            </div>

            <div class="app-header-actions">
              <span class="save-status">Saved</span>

              <div class="app-avatar">A</div>
            </div>
          </div>

          <div class="app-body">
            <!-- Sidebar -->

            <aside class="app-sidebar">
              <div class="sidebar-label">WORKSPACE</div>

              <div class="sidebar-item">
                <img src={icon} alt="" aria-hidden="true" />
                <span>Home</span>
              </div>

              <div class="sidebar-item active">
                <img src={icon} alt="" aria-hidden="true" />
                <span>Documents</span>
              </div>

              <div class="sidebar-item">
                <img src={icon} alt="" aria-hidden="true" />
                <span>Collections</span>
              </div>

              <div class="sidebar-item">
                <img src={icon} alt="" aria-hidden="true" />
                <span>Templates</span>
              </div>

              <div class="sidebar-divider"></div>

              <div class="sidebar-label">MY DOCUMENTS</div>

              {
                documents.map((document) => (
                  <div class="sidebar-document">
                    <img src={icon} alt="" aria-hidden="true" />
                    <span>{document.title}</span>
                  </div>
                ))
              }
            </aside>

            <!-- Document Editor -->

            <div class="editor">
              <div class="editor-header">
                <div class="editor-breadcrumb">
                  Documents
                  <span>/</span>
                  My Creative Space
                </div>

                <div class="editor-actions">
                  <img src={icon} alt="" aria-hidden="true" />
                  <img src={icon} alt="" aria-hidden="true" />
                </div>
              </div>

              <div class="editor-canvas">
                <article class="document-page">
                  <div class="document-cover">
                    <div class="document-cover-shape"></div>

                    <img
                      src={icon}
                      alt=""
                      aria-hidden="true"
                      class="document-cover-icon"
                    />
                  </div>

                  <div class="document-content">
                    <div class="document-icon">
                      <img src={icon} alt="" aria-hidden="true" />
                    </div>

                    <span class="document-date"> THURSDAY, OCTOBER 15 </span>

                    <h2>My Creative Space</h2>

                    <p class="document-intro">
                      A place for the little things, the big ideas, and
                      everything beautiful in between.
                    </p>

                    <div class="document-divider"></div>

                    <h3>Where ideas begin</h3>

                    <p>
                      Every wonderful creation starts somewhere. Sometimes with
                      a plan, sometimes with a question, and sometimes with
                      nothing more than a little curiosity.
                    </p>

                    <div class="document-callout">
                      <img src={icon} alt="" aria-hidden="true" />

                      <p>
                        Give yourself permission to create something
                        extraordinary.
                      </p>
                    </div>

                    <h3>Things I'm dreaming up</h3>

                    <div class="document-tasks">
                      <div class="document-task">
                        <span class="task-checkbox checked"></span>
                        <span>Create something meaningful</span>
                      </div>

                      <div class="document-task">
                        <span class="task-checkbox checked"></span>
                        <span>Explore a new idea</span>
                      </div>

                      <div class="document-task">
                        <span class="task-checkbox"></span>
                        <span>Keep imagining</span>
                      </div>
                    </div>
                  </div>
                </article>
              </div>

              <div class="editor-toolbar">
                <span class="toolbar-text active">B</span>
                <span class="toolbar-text italic">I</span>
                <span class="toolbar-text underline">U</span>

                <span class="toolbar-separator"></span>

                <img src={icon} alt="" aria-hidden="true" />
                <img src={icon} alt="" aria-hidden="true" />
                <img src={icon} alt="" aria-hidden="true" />
              </div>
            </div>
          </div>
        </div>

        <div class="showcase-caption">
          <img src={icon} alt="" aria-hidden="true" />
          <span>A beautiful home for everything you create.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================
       INTRODUCTION
       ====================================================== -->

  <section class="introduction section" id="discover">
    <div class="container introduction-container">
      <div class="section-eyebrow" data-reveal="up">
        <img src={icon} alt="" aria-hidden="true" />
        MEET PENNED
      </div>

      <h2 data-reveal="up">
        More than documents.
        <span>A space to think.</span>
      </h2>

      <p data-reveal="up">
        Your ideas don't always arrive in perfect order. Your workspace
        shouldn't expect them to. Penned brings writing, creativity, and
        organization together in a space designed around the way you think.
      </p>

      <div class="introduction-decoration" aria-hidden="true">
        <img src={icon} alt="" />
        <img src={icon} alt="" />
        <img src={icon} alt="" />
      </div>
    </div>
  </section>

  <!-- ======================================================
       FEATURES
       ====================================================== -->

  <section class="features-section section">
    <div class="container">
      <div class="section-heading" data-reveal="up">
        <div class="section-eyebrow">
          <img src={icon} alt="" aria-hidden="true" />
          THE PENNED EXPERIENCE
        </div>

        <h2>
          Everything you need.
          <span>Nothing in your way.</span>
        </h2>

        <p>
          Thoughtful tools for writing, organizing, and making your ideas
          entirely your own.
        </p>
      </div>

      <div class="features-grid">
        {
          features.map((feature, index) => (
            <a href={feature.href} class="feature-card" data-reveal="up">
              <div class="feature-card-top">
                <span class="feature-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="feature-icon">
                  <img src={icon} alt="" aria-hidden="true" />
                </div>
              </div>

              <div class="feature-card-content">
                <span class="feature-label">{feature.label}</span>

                <h3>{feature.title}</h3>

                <p>{feature.description}</p>
              </div>

              <div class="feature-card-bottom">
                <span class="feature-card-line" />

                <img src={icon} alt="" aria-hidden="true" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================
       WRITING
       ====================================================== -->

  <section class="writing-section section">
    <div class="container writing-layout">
      <div class="writing-content" data-reveal="up">
        <div class="section-eyebrow">
          <img src={icon} alt="" aria-hidden="true" />
          WRITE BEAUTIFULLY
        </div>

        <h2>
          Let your words
          <span>take shape.</span>
        </h2>

        <p>
          A beautiful writing experience gives every thought room to become
          something more. Create expressive documents that feel as wonderful to
          make as they do to revisit.
        </p>

        <a href="/product/write" class="text-link">
          Explore writing
          <img src={icon} alt="" aria-hidden="true" />
        </a>
      </div>

      <div class="writing-visual" data-reveal="up">
        <article class="writing-document">
          <div class="writing-document-label">
            <img src={icon} alt="" aria-hidden="true" />
            PERSONAL JOURNAL
          </div>

          <h3>The beauty of beginning again.</h3>

          <p>
            There is something wonderful about a blank page. Not because it asks
            us to be perfect, but because it gives us somewhere to begin.
          </p>

          <div class="writing-highlight">
            Every thought deserves a place to grow.
          </div>

          <p>
            A sentence becomes a paragraph. A paragraph becomes a story. And
            somewhere along the way, an idea becomes something real.
          </p>

          <div class="writing-document-footer">
            <img src={icon} alt="" aria-hidden="true" />
            Penned
          </div>
        </article>

        <div class="floating-toolbar">
          <span class="selected">B</span>
          <span class="italic">I</span>
          <span class="underline">U</span>

          <div class="floating-toolbar-divider"></div>

          <img src={icon} alt="" aria-hidden="true" />
          <img src={icon} alt="" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================
       ORGANIZATION
       ====================================================== -->

  <section class="organization-section section">
    <div class="container">
      <div class="section-heading centered" data-reveal="up">
        <div class="section-eyebrow">
          <img src={icon} alt="" aria-hidden="true" />
          ORGANIZE YOUR WORLD
        </div>

        <h2>
          A little more order.
          <span>A lot more possibility.</span>
        </h2>

        <p>
          Keep your ideas close, your documents organized, and everything
          important right where it belongs.
        </p>
      </div>

      <div class="organization-window" data-reveal="up">
        <div class="organization-header">
          <div class="organization-header-title">
            <img src={icon} alt="" aria-hidden="true" />
            My Workspace
          </div>

          <div class="organization-header-actions">
            <img src={icon} alt="" aria-hidden="true" />
            <img src={icon} alt="" aria-hidden="true" />
          </div>
        </div>

        <div class="organization-content">
          <div class="organization-grid">
            {
              collections.map((collection) => (
                <div class={`collection-card ${collection.className}`}>
                  <div class="collection-icon">
                    <img src={icon} alt="" aria-hidden="true" />
                  </div>

                  <h3>{collection.title}</h3>

                  <p>{collection.count}</p>
                </div>
              ))
            }
          </div>

          <div class="recent-documents">
            <div class="recent-heading">
              <h3>Recently Opened</h3>
              <span>YOUR DOCUMENTS</span>
            </div>

            {
              documents.map((document) => (
                <div class="recent-document">
                  <div class="recent-document-icon">
                    <img src={icon} alt="" aria-hidden="true" />
                  </div>

                  <div class="recent-document-information">
                    <h4>{document.title}</h4>
                    <p>{document.category}</p>
                  </div>

                  <span class="recent-date">{document.date}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================
       CUSTOMIZATION
       ====================================================== -->

  <section class="customization-section section">
    <div class="container customization-layout">
      <div class="customization-content" data-reveal="up">
        <div class="section-eyebrow">
          <img src={icon} alt="" aria-hidden="true" />
          MAKE IT YOURS
        </div>

        <h2>
          Your style.
          <span>Every detail.</span>
        </h2>

        <p>
          Your documents should reflect the person creating them. Explore
          beautiful styles, expressive colors, and thoughtful details that make
          every page yours.
        </p>

        <a href="/product/customize" class="text-link">
          Explore customization
          <img src={icon} alt="" aria-hidden="true" />
        </a>
      </div>

      <div class="customization-visual" data-reveal="up">
        <div class="style-document style-document-back">
          <div class="style-document-content">
            <img src={icon} alt="" aria-hidden="true" />

            <span>THE LITTLE THINGS</span>

            <h3>Finding beauty in everyday moments.</h3>

            <div class="style-placeholder-lines">
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>

        <div class="style-document style-document-front">
          <div class="style-document-content">
            <img src={icon} alt="" aria-hidden="true" />

            <span>MY PERSONAL SPACE</span>

            <h3>Made for the way I think.</h3>

            <p>
              A beautiful collection of thoughts, ideas, and everything in
              between.
            </p>

            <div class="style-color-options">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>

        <div class="customization-badge">
          <img src={icon} alt="" aria-hidden="true" />
          Beautifully yours
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================
       TEMPLATES
       ====================================================== -->

  <section class="templates-section section">
    <div class="container">
      <div class="templates-heading" data-reveal="up">
        <div>
          <div class="section-eyebrow">
            <img src={icon} alt="" aria-hidden="true" />
            START WITH INSPIRATION
          </div>

          <h2>
            A beautiful beginning
            <span>for every idea.</span>
          </h2>

          <p>
            Find a starting point for your next great idea with thoughtfully
            designed document templates.
          </p>
        </div>

        <a href="/templates" class="text-link">
          Explore templates
          <img src={icon} alt="" aria-hidden="true" />
        </a>
      </div>

      <div class="templates-grid">
        {
          templates.map((template) => (
            <article
              class={`template-card ${template.className}`}
              data-reveal="up"
            >
              <div class="template-preview">
                <div class="template-paper">
                  <img
                    src={icon}
                    alt=""
                    aria-hidden="true"
                    class="template-paper-icon"
                  />

                  <span>{template.category}</span>

                  <h3>{template.title}</h3>

                  <div class="template-paper-lines">
                    {template.lines.map((line) => (
                      <div class="template-paper-line">
                        <span>{line}</span>
                        <i />
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="template-details">
                <span>{template.category}</span>

                <h3>{template.title}</h3>

                <p>{template.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================
       CLOSING
       ====================================================== -->

  <section class="closing-section section">
    <div class="container">
      <div class="closing-content" data-reveal="up">
        <div class="closing-icon">
          <img src={icon} alt="" aria-hidden="true" />
        </div>

        <div class="section-eyebrow">YOUR NEXT CHAPTER STARTS HERE</div>

        <h2>
          Something wonderful
          <span>starts with a word.</span>
        </h2>

        <p>Every idea has a beginning. Give yours a beautiful place to grow.</p>

        <a href="/download" class="button button-primary closing-button">
          Get Penned
          <img src={icon} alt="" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ========================================================
     SHARED STYLES
     ======================================================== */

  .section-eyebrow {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    color: var(--color-purple-light);

    font-size: 0.6875rem;
    font-weight: 900;

    letter-spacing: 0.1em;
    line-height: 1.5;
  }

  .section-eyebrow img {
    width: 16px;
    height: 16px;

    object-fit: contain;
  }

  .section-heading {
    max-width: 780px;

    margin-bottom: 40px;
  }

  .section-heading.centered {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading h2,
  .writing-content h2,
  .customization-content h2,
  .templates-heading h2,
  .closing-content h2 {
    margin-top: 18px;

    font-size: clamp(2.25rem, 8vw, 4.5rem);
    font-weight: 900;

    line-height: 1.1;
    letter-spacing: -0.055em;
  }

  .section-heading h2 span,
  .writing-content h2 span,
  .customization-content h2 span,
  .templates-heading h2 span,
  .closing-content h2 span {
    display: block;

    color: var(--color-purple-light);
  }

  .section-heading p,
  .writing-content > p,
  .customization-content > p,
  .templates-heading p,
  .closing-content > p {
    max-width: 580px;

    margin-top: 20px;

    color: var(--text-secondary);

    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 900;

    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;

    gap: 12px;

    margin-top: 28px;

    color: var(--color-purple-light);

    font-size: 1rem;
    font-weight: 900;

    transition: gap 250ms ease;
  }

  .text-link:hover {
    gap: 18px;
  }

  .text-link img {
    width: 18px;
    height: 18px;
  }

  /* ========================================================
     HERO
     ======================================================== */

  .hero {
    position: relative;

    padding-top: 72px;
    padding-bottom: 72px;

    overflow: hidden;

    background: #000000;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        ellipse at 10% 5%,
        rgba(121, 66, 255, 0.16),
        transparent 35%
      ),
      radial-gradient(
        ellipse at 90% 45%,
        rgba(72, 33, 184, 0.12),
        transparent 40%
      );
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 900px;

    margin-inline: auto;

    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 10px 16px;

    background: rgba(121, 66, 255, 0.08);

    border: 1px solid var(--border-secondary);
    border-radius: 999px;

    color: var(--color-purple-light);

    font-size: 0.625rem;
    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .hero-eyebrow img {
    width: 15px;
    height: 15px;
  }

  .hero-title {
    margin-top: 28px;

    font-size: clamp(3rem, 11vw, 7rem);
    font-weight: 900;

    line-height: 1.05;
    letter-spacing: -0.07em;
  }

  .hero-title span {
    display: block;

    color: var(--color-purple-light);
  }

  .hero-description {
    max-width: 620px;

    margin-top: 24px;

    font-size: clamp(1rem, 3vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;

    gap: 12px;

    width: 100%;
    max-width: 340px;

    margin-top: 32px;
  }

  .hero-button,
  .hero-button-secondary {
    width: 100%;
    min-height: 54px;
  }

  .hero-button {
    gap: 12px;
  }

  .hero-button img {
    width: 18px;
    height: 18px;
  }

  .hero-button-secondary {
    background: var(--background-card);

    border: 1px solid var(--border-primary);

    color: #ffffff;
  }

  .hero-button-secondary:hover {
    background: var(--background-card-hover);
    color: #ffffff;
  }

  /* ========================================================
     APPLICATION SHOWCASE
     ======================================================== */

  .hero-showcase {
    position: relative;

    max-width: 1120px;

    margin: 72px auto 0;
  }

  .showcase-glow {
    position: absolute;

    inset: 10%;

    background: rgba(121, 66, 255, 0.18);

    filter: blur(80px);

    pointer-events: none;
  }

  .app-window {
    position: relative;

    width: 100%;

    overflow: hidden;

    background: #0c0b11;

    border: 1px solid #322547;
    border-radius: 18px;

    box-shadow:
      0 30px 100px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(121, 66, 255, 0.08);
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    height: 54px;

    padding: 0 16px;

    background: #100e17;

    border-bottom: 1px solid #24202e;
  }

  .app-header-brand,
  .app-header-actions {
    display: flex;
    align-items: center;

    gap: 10px;
  }

  .app-header-brand {
    color: #ffffff;

    font-size: 0.75rem;
  }

  .app-brand-icon {
    width: 28px;
    height: 28px;
  }

  .save-status {
    display: none;

    color: #a79bb5;

    font-size: 0.6875rem;
  }

  .app-avatar {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 28px;
    height: 28px;

    background: #442b75;

    border-radius: 50%;

    color: #ffffff;

    font-size: 0.75rem;
  }

  .app-body {
    display: flex;

    min-height: 450px;
  }

  .app-sidebar {
    display: none;
  }

  .editor {
    display: flex;
    flex-direction: column;

    flex: 1;
    min-width: 0;

    background: #17141d;
  }

  .editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 44px;

    padding: 0 14px;

    border-bottom: 1px solid #292430;
  }

  .editor-breadcrumb {
    overflow: hidden;

    color: #a8a0b3;

    font-size: 0.625rem;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .editor-breadcrumb span {
    margin-inline: 6px;

    color: #5e536d;
  }

  .editor-actions {
    display: flex;
    align-items: center;

    gap: 12px;
  }

  .editor-actions img {
    width: 16px;
    height: 16px;
  }

  .editor-canvas {
    display: flex;
    justify-content: center;

    flex: 1;
    min-width: 0;

    padding: 16px 12px 24px;
  }

  .document-page {
    width: 100%;
    max-width: 650px;

    overflow: hidden;

    background: #f0f0f2;

    border-radius: 10px;

    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .document-cover {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    height: 110px;

    overflow: hidden;

    background: linear-gradient(135deg, #4c2bb5, #8c55f4 55%, #d5a9ff);
  }

  .document-cover-shape {
    position: absolute;

    top: -80px;
    right: -40px;

    width: 240px;
    height: 240px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.12);
  }

  .document-cover-icon {
    position: relative;

    width: 46px;
    height: 46px;
  }

  .document-content {
    padding: 20px;
  }

  .document-icon {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    margin-top: -44px;
    margin-bottom: 18px;

    background: #ffffff;

    border: 3px solid #f0f0f2;
    border-radius: 13px;
  }

  .document-icon img {
    width: 24px;
    height: 24px;
  }

  .document-date {
    color: #8c7a9d;

    font-size: 0.5625rem;
    letter-spacing: 0.1em;
  }

  .document-content h2 {
    margin-top: 10px;

    color: #241b31;

    font-size: clamp(1.25rem, 4vw, 2rem);
    letter-spacing: -0.05em;
  }

  .document-intro {
    margin-top: 12px;

    color: #625b6d;

    font-size: 0.6875rem;
    line-height: 1.7;
  }

  .document-divider {
    height: 1px;

    margin: 22px 0;

    background: #ded9e4;
  }

  .document-content h3 {
    margin-top: 20px;
    margin-bottom: 10px;

    color: #2c2039;

    font-size: 0.875rem;
  }

  .document-content > p:not(.document-intro) {
    color: #625b6d;

    font-size: 0.625rem;
    line-height: 1.8;
  }

  .document-callout {
    display: flex;
    align-items: flex-start;

    gap: 10px;

    margin-top: 20px;
    padding: 14px;

    background: #e4d9fa;

    border-radius: 10px;
  }

  .document-callout img {
    width: 20px;
    height: 20px;

    flex-shrink: 0;
  }

  .document-callout p {
    color: #4b3470;

    font-size: 0.625rem;
    line-height: 1.6;
  }

  .document-tasks {
    display: flex;
    flex-direction: column;

    gap: 10px;
  }

  .document-task {
    display: flex;
    align-items: center;

    gap: 10px;

    color: #5b5365;

    font-size: 0.625rem;
  }

  .task-checkbox {
    width: 17px;
    height: 17px;

    flex-shrink: 0;

    border: 1px solid #b8afc2;
    border-radius: 5px;
  }

  .task-checkbox.checked {
    background: #8d5df2;

    border-color: #8d5df2;
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 14px;

    min-height: 46px;

    background: #100e17;

    border-top: 1px solid #292430;
  }

  .toolbar-text {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 26px;
    height: 26px;

    color: #bdb1ca;

    font-size: 0.75rem;
  }

  .toolbar-text.active {
    background: #35254e;

    border-radius: 6px;

    color: #d9c3ff;
  }

  .toolbar-text.italic {
    font-style: italic;
  }

  .toolbar-text.underline {
    text-decoration: underline;
  }

  .toolbar-separator {
    width: 1px;
    height: 18px;

    background: #40364d;
  }

  .editor-toolbar img {
    width: 16px;
    height: 16px;
  }

  .showcase-caption {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    margin-top: 24px;

    color: var(--text-muted);

    font-size: 0.6875rem;

    text-align: center;
  }

  .showcase-caption img {
    width: 14px;
    height: 14px;
  }

  /* ========================================================
     INTRODUCTION
     ======================================================== */

  .introduction {
    overflow: hidden;

    background: #08060f;

    text-align: center;
  }

  .introduction-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .introduction h2 {
    max-width: 850px;

    margin-top: 20px;

    font-size: clamp(2.25rem, 8vw, 5rem);
    line-height: 1.1;

    letter-spacing: -0.06em;
  }

  .introduction h2 span {
    display: block;

    color: var(--color-purple-light);
  }

  .introduction-container > p {
    max-width: 650px;

    margin-top: 28px;

    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.8;
  }

  .introduction-decoration {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 28px;

    margin-top: 48px;
  }

  .introduction-decoration img {
    width: 20px;
    height: 20px;
  }

  .introduction-decoration img:nth-child(2) {
    width: 32px;
    height: 32px;
  }

  /* ========================================================
     FEATURES
     ======================================================== */

  .features-section {
    background: #000000;
  }

  .features-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    gap: 16px;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 340px;

    padding: 28px;

    overflow: hidden;

    background: #100b1d;

    border: 1px solid #292136;
    border-radius: 26px;

    color: #ffffff;

    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background 300ms ease;
  }

  .feature-card:hover {
    background: #180e2c;

    border-color: #7942ff;

    color: #ffffff;
  }

  .feature-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .feature-number {
    color: #746584;

    font-size: 0.75rem;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 54px;
    height: 54px;

    background: #24143e;

    border: 1px solid #3a2558;
    border-radius: 18px;
  }

  .feature-icon img {
    width: 28px;
    height: 28px;
  }

  .feature-card-content {
    margin-top: 48px;
  }

  .feature-label {
    color: #b58aff;

    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .feature-card h3 {
    margin-top: 12px;

    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .feature-card p {
    margin-top: 14px;

    color: #a89bb7;

    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .feature-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 32px;
  }

  .feature-card-line {
    width: 70%;
    height: 1px;

    background: #38264f;
  }

  .feature-card-bottom img {
    width: 20px;
    height: 20px;
  }

  /* ========================================================
     WRITING
     ======================================================== */

  .writing-section {
    overflow: hidden;

    background: #08060f;
  }

  .writing-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    align-items: center;

    gap: 56px;
  }

  .writing-visual {
    position: relative;

    min-width: 0;

    padding: 20px 12px 44px;

    background: linear-gradient(145deg, #261443, #100b1d);

    border: 1px solid #38244e;
    border-radius: 30px;
  }

  .writing-document {
    max-width: 520px;

    margin-inline: auto;
    padding: 28px 24px;

    background: #f0f0f2;

    border-radius: 16px;

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .writing-document-label {
    display: flex;
    align-items: center;

    gap: 8px;

    color: #8c6eaa;

    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .writing-document-label img {
    width: 16px;
    height: 16px;
  }

  .writing-document h3 {
    margin-top: 28px;

    color: #251b32;

    font-size: clamp(1.5rem, 5vw, 2.5rem);
    line-height: 1.2;
  }

  .writing-document > p {
    margin-top: 22px;

    color: #665c70;

    font-size: 0.75rem;
    line-height: 1.9;
  }

  .writing-highlight {
    margin-top: 24px;
    padding: 18px;

    background: #e5d9f8;

    border-left: 4px solid #8d5df2;
    border-radius: 8px;

    color: #573982;

    font-size: 0.875rem;
    line-height: 1.6;
  }

  .writing-document-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 8px;

    margin-top: 32px;

    color: #9c8ca9;

    font-size: 0.6875rem;
  }

  .writing-document-footer img {
    width: 16px;
    height: 16px;
  }

  .floating-toolbar {
    position: absolute;

    bottom: 16px;
    left: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 14px;

    width: max-content;
    max-width: calc(100% - 24px);

    padding: 12px 16px;

    background: #171020;

    border: 1px solid #3c2b56;
    border-radius: 14px;

    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);

    transform: translateX(-50%);
  }

  .floating-toolbar span {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 24px;
    height: 24px;

    color: #d6c6e8;

    font-size: 0.875rem;
  }

  .floating-toolbar .selected {
    background: #442b75;

    border-radius: 6px;
  }

  .floating-toolbar .italic {
    font-style: italic;
  }

  .floating-toolbar .underline {
    text-decoration: underline;
  }

  .floating-toolbar-divider {
    width: 1px;
    height: 20px;

    background: #49395b;
  }

  .floating-toolbar img {
    width: 18px;
    height: 18px;
  }

  /* ========================================================
     ORGANIZATION
     ======================================================== */

  .organization-section {
    background: #000000;
  }

  .organization-window {
    max-width: 1000px;

    margin-inline: auto;

    overflow: hidden;

    background: #100e17;

    border: 1px solid #30263d;
    border-radius: 24px;

    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
  }

  .organization-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 64px;

    padding: 16px 20px;

    border-bottom: 1px solid #2a2235;
  }

  .organization-header-title {
    display: flex;
    align-items: center;

    gap: 10px;

    color: #ffffff;

    font-size: 0.9375rem;
  }

  .organization-header-title img {
    width: 22px;
    height: 22px;
  }

  .organization-header-actions {
    display: flex;
    align-items: center;

    gap: 16px;
  }

  .organization-header-actions img {
    width: 18px;
    height: 18px;
  }

  .organization-content {
    padding: 20px;
  }

  .organization-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 12px;
  }

  .collection-card {
    min-width: 0;
    min-height: 145px;

    padding: 18px;

    border-radius: 18px;
  }

  .collection-purple {
    background: #33205b;
  }

  .collection-pink {
    background: #542b55;
  }

  .collection-lavender {
    background: #43345e;
  }

  .collection-blue {
    background: #252e58;
  }

  .collection-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    background: rgba(255, 255, 255, 0.1);

    border-radius: 12px;
  }

  .collection-icon img {
    width: 22px;
    height: 22px;
  }

  .collection-card h3 {
    margin-top: 20px;

    color: #ffffff;

    font-size: 0.875rem;
    line-height: 1.3;
  }

  .collection-card p {
    margin-top: 6px;

    color: rgba(255, 255, 255, 0.65);

    font-size: 0.6875rem;
  }

  .recent-documents {
    margin-top: 32px;
  }

  .recent-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-bottom: 16px;
  }

  .recent-heading h3 {
    color: #ffffff;

    font-size: 1rem;
  }

  .recent-heading span {
    color: #8c7a9d;

    font-size: 0.5625rem;
    letter-spacing: 0.08em;
  }

  .recent-document {
    display: flex;
    align-items: center;

    gap: 12px;

    min-width: 0;

    padding: 14px 0;

    border-bottom: 1px solid #292330;
  }

  .recent-document:last-child {
    border-bottom: none;
  }

  .recent-document-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    flex-shrink: 0;

    background: #2c2040;

    border-radius: 12px;
  }

  .recent-document-icon img {
    width: 22px;
    height: 22px;
  }

  .recent-document-information {
    flex: 1;
    min-width: 0;
  }

  .recent-document-information h4 {
    overflow: hidden;

    color: #ffffff;

    font-size: 0.8125rem;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-document-information p {
    margin-top: 4px;

    color: #8e839b;

    font-size: 0.6875rem;
  }

  .recent-date {
    display: none;

    color: #8e839b;

    font-size: 0.6875rem;
  }

  /* ========================================================
     CUSTOMIZATION
     ======================================================== */

  .customization-section {
    overflow: hidden;

    background: #08060f;
  }

  .customization-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    align-items: center;

    gap: 56px;
  }

  .customization-visual {
    position: relative;

    min-height: 440px;
  }

  .style-document {
    position: absolute;

    width: 75%;
    max-width: 340px;

    min-height: 340px;

    overflow: hidden;

    border-radius: 20px;

    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
  }

  .style-document-back {
    top: 0;
    right: 0;

    background: #e6d6ff;

    transform: rotate(8deg);
  }

  .style-document-front {
    top: 55px;
    left: 0;

    background: #f0f0f2;

    transform: rotate(-5deg);
  }

  .style-document-content {
    padding: 28px;
  }

  .style-document-content > img {
    width: 28px;
    height: 28px;

    margin-bottom: 24px;
  }

  .style-document-content > span {
    display: block;

    color: #8a6ba5;

    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .style-document-content h3 {
    margin-top: 16px;

    color: #2c2039;

    font-size: clamp(1.25rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .style-document-content p {
    margin-top: 20px;

    color: #665c70;

    font-size: 0.75rem;
    line-height: 1.7;
  }

  .style-placeholder-lines {
    display: flex;
    flex-direction: column;

    gap: 12px;

    margin-top: 28px;
  }

  .style-placeholder-lines i {
    display: block;

    width: 100%;
    height: 8px;

    background: rgba(88, 56, 128, 0.15);

    border-radius: 999px;
  }

  .style-placeholder-lines i:last-child {
    width: 60%;
  }

  .style-color-options {
    display: flex;

    gap: 10px;

    margin-top: 32px;
  }

  .style-color-options i {
    width: 22px;
    height: 22px;

    border-radius: 50%;
  }

  .style-color-options i:nth-child(1) {
    background: #7942ff;
  }

  .style-color-options i:nth-child(2) {
    background: #d69cda;
  }

  .style-color-options i:nth-child(3) {
    background: #a5a0db;
  }

  .style-color-options i:nth-child(4) {
    background: #b58aff;
  }

  .customization-badge {
    position: absolute;

    right: 0;
    bottom: 0;

    display: flex;
    align-items: center;

    gap: 10px;

    padding: 14px 18px;

    background: #24143e;

    border: 1px solid #4b3270;
    border-radius: 999px;

    color: #ffffff;

    font-size: 0.75rem;

    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
  }

  .customization-badge img {
    width: 18px;
    height: 18px;
  }

  /* ========================================================
     TEMPLATES
     ======================================================== */

  .templates-section {
    background: #000000;
  }

  .templates-heading {
    display: flex;
    flex-direction: column;

    gap: 20px;

    margin-bottom: 40px;
  }

  .templates-heading .text-link {
    margin-top: 0;
  }

  .templates-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    gap: 20px;
  }

  .template-card {
    min-width: 0;

    overflow: hidden;

    background: #100b1d;

    border: 1px solid #292136;
    border-radius: 24px;
  }

  .template-preview {
    display: flex;
    align-items: flex-end;
    justify-content: center;

    height: 280px;

    padding: 28px 28px 0;

    overflow: hidden;
  }

  .template-lavender .template-preview {
    background: #3a285d;
  }

  .template-pink .template-preview {
    background: #4b2a50;
  }

  .template-violet .template-preview {
    background: #2e2458;
  }

  .template-paper {
    width: 100%;
    max-width: 280px;
    min-height: 290px;

    padding: 26px;

    background: #f0f0f2;

    border-radius: 12px 12px 0 0;

    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.2);
  }

  .template-paper-icon {
    width: 24px;
    height: 24px;

    margin-bottom: 20px;
  }

  .template-paper > span {
    display: block;

    color: #9a7baa;

    font-size: 0.5625rem;
    letter-spacing: 0.1em;
  }

  .template-paper h3 {
    margin-top: 12px;

    color: #2c2039;

    font-size: 1.25rem;
  }

  .template-paper-lines {
    display: flex;
    flex-direction: column;

    gap: 18px;

    margin-top: 28px;
  }

  .template-paper-line span {
    display: block;

    color: #75697e;

    font-size: 0.5625rem;
  }

  .template-paper-line i {
    display: block;

    height: 1px;

    margin-top: 8px;

    background: #d9d2df;
  }

  .template-details {
    padding: 24px;
  }

  .template-details > span {
    color: #b58aff;

    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .template-details h3 {
    margin-top: 10px;

    color: #ffffff;

    font-size: 1.25rem;
  }

  .template-details p {
    margin-top: 10px;

    color: #a89bb7;

    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ========================================================
     CLOSING
     ======================================================== */

  .closing-section {
    position: relative;

    overflow: hidden;

    background:
      radial-gradient(
        ellipse at 50% 100%,
        rgba(121, 66, 255, 0.18),
        transparent 65%
      ),
      #08060f;
  }

  .closing-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 800px;

    margin-inline: auto;

    text-align: center;
  }

  .closing-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 76px;
    height: 76px;

    margin-bottom: 28px;

    background: #24143e;

    border: 1px solid #4b3270;
    border-radius: 24px;
  }

  .closing-icon img {
    width: 42px;
    height: 42px;
  }

  .closing-content > p {
    margin-inline: auto;
  }

  .closing-button {
    gap: 12px;

    min-width: 200px;

    margin-top: 32px;
  }

  .closing-button img {
    width: 18px;
    height: 18px;
  }

  /* ========================================================
