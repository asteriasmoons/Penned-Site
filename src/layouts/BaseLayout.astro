---
/* ==========================================================
   PENNED — BASE LAYOUT
   Mobile-First | Dark Mode | Responsive
   ========================================================== */

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "Penned — Your Words. Your World.",
  description = "A beautiful space to write, create, organize, and personalize your documents.",
  image,
  canonical,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const brand = "Penned";

const pageTitle =
  title === brand ||
  title.startsWith(`${brand} —`) ||
  title.endsWith(`| ${brand}`)
    ? title
    : `${title} | ${brand}`;

const siteURL = Astro.site ?? new URL(Astro.url.origin);

const canonicalURL = canonical
  ? new URL(canonical, siteURL).toString()
  : new URL(Astro.url.pathname, siteURL).toString();

const socialImage = image ? new URL(image, siteURL).toString() : undefined;

const navigation = [
  {
    label: "Product",
    href: "/product",
    children: [
      { label: "Overview", href: "/product" },
      { label: "Write", href: "/product/write" },
      { label: "Organize", href: "/product/organize" },
      { label: "Plan", href: "/product/plan" },
      { label: "Customize", href: "/product/customize" },
      { label: "Share", href: "/product/share" },
    ],
  },
  {
    label: "Templates",
    href: "/templates",
  },
  {
    label: "Resources",
    href: "/resources",
    children: [
      { label: "Overview", href: "/resources" },
      { label: "Blog", href: "/resources/blog" },
      { label: "Guides", href: "/resources/guides" },
      { label: "Changelog", href: "/resources/changelog" },
      { label: "Support", href: "/support" },
    ],
  },
  {
    label: "Pricing",
    href: "/pricing",
  },
];

const footerGroups = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "/product" },
      { label: "Write", href: "/product/write" },
      { label: "Organize", href: "/product/organize" },
      { label: "Customize", href: "/product/customize" },
      { label: "Templates", href: "/templates" },
      { label: "Pricing", href: "/pricing" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Blog", href: "/resources/blog" },
      { label: "Guides", href: "/resources/guides" },
      { label: "Changelog", href: "/resources/changelog" },
      { label: "Help Center", href: "/support" },
    ],
  },
  {
    title: "Penned",
    links: [
      { label: "Download", href: "/download" },
      { label: "Contact", href: "/support/contact" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms of Service", href: "/terms" },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const path = href.replace(/\/$/, "") || "/";

  return (
    currentPath === path || (path !== "/" && currentPath.startsWith(`${path}/`))
  );
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    <meta name="theme-color" content="#000000" />

    <meta name="color-scheme" content="dark" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->

    <meta property="og:type" content={type} />

    <meta property="og:site_name" content={brand} />

    <meta property="og:title" content={pageTitle} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalURL} />

    {socialImage && <meta property="og:image" content={socialImage} />}

    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }

    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <!-- Social Cards -->

    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />

    <meta name="twitter:title" content={pageTitle} />

    <meta name="twitter:description" content={description} />

    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <!-- Structured Data -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: brand,
        url: siteURL.toString(),
        description,
      })}
    />

    <slot name="head" />
  </head>

  <body>
    <!-- Accessibility -->

    <a class="skip-link" href="#main-content"> Skip to content </a>

    <!-- ====================================================
         HEADER
         ==================================================== -->

    <header class="site-header" id="site-header">
      <div class="header-container">
        <!-- Brand -->

        <a href="/" class="brand" aria-label="Penned homepage">
          <span class="brand-mark" aria-hidden="true">
            <img
              src="/images/branding/penned.png"
              alt=""
              width="42"
              height="42"
            />
          </span>

          <span class="brand-name">Penned</span>
        </a>

        <!-- Desktop Navigation -->

        <nav class="desktop-navigation" aria-label="Main navigation">
          {
            navigation.map((item) =>
              item.children ? (
                <div class="nav-dropdown">
                  <a
                    href={item.href}
                    class:list={["nav-link", { active: isActive(item.href) }]}
                    aria-current={
                      currentPath === item.href ? "page" : undefined
                    }
                  >
                    {item.label}

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </a>

                  <div class="dropdown-panel">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          "dropdown-link",
                          { active: currentPath === child.href },
                        ]}
                        aria-current={
                          currentPath === child.href ? "page" : undefined
                        }
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive(item.href) }]}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ),
            )
          }
        </nav>

        <!-- Header Actions -->

        <div class="header-actions">
          <a href="/download" class="header-cta"> Get Penned </a>

          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- ==================================================
           MOBILE NAVIGATION
           ================================================== -->

      <nav
        class="mobile-navigation"
        id="mobile-navigation"
        aria-label="Mobile navigation"
        inert
      >
        <div class="mobile-navigation-inner">
          {
            navigation.map((item) =>
              item.children ? (
                <details class="mobile-group">
                  <summary>
                    <span>{item.label}</span>

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>

                  <div class="mobile-submenu">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          "mobile-submenu-link",
                          { active: currentPath === child.href },
                        ]}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </details>
              ) : (
                <a
                  href={item.href}
                  class:list={["mobile-link", { active: isActive(item.href) }]}
                >
                  {item.label}
                </a>
              ),
            )
          }

          <a href="/download" class="mobile-download"> Get Penned </a>
        </div>
      </nav>
    </header>

    <!-- ====================================================
         MAIN CONTENT
         ==================================================== -->

    <main id="main-content">
      <slot />
    </main>

    <!-- ====================================================
         FOOTER
         ==================================================== -->

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-top">
          <!-- Brand Column -->

          <div class="footer-brand">
            <a href="/" class="brand">
              <span class="brand-mark" aria-hidden="true">
                <img
                  src="/images/branding/penned.png"
                  alt=""
                  width="42"
                  height="42"
                  loading="lazy"
                />
              </span>

              <span class="brand-name">Penned</span>
            </a>

            <p class="footer-description">Your words. Your world.</p>

            <p class="footer-tagline">
              A beautiful space for everything worth writing.
            </p>
          </div>

          <!-- Footer Navigation -->

          <div class="footer-links">
            {
              footerGroups.map((group) => (
                <div class="footer-column">
                  <h2>{group.title}</h2>

                  <ul>
                    {group.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {year} Penned. All rights reserved.</p>

          <div class="footer-legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- ====================================================
         INTERACTION LOGIC
         ==================================================== -->

    <script>
      function initializePennedLayout() {
        const header = document.getElementById("site-header");
        const toggle = document.getElementById("menu-toggle");
        const mobileNav = document.getElementById("mobile-navigation");

        if (!header || !toggle || !mobileNav) return;

        const desktopQuery = window.matchMedia("(min-width: 1024px)");

        let isOpen = false;

        function setMenuOpen(open: boolean) {
          isOpen = open;

          header?.classList.toggle("menu-open", open);

          toggle?.setAttribute("aria-expanded", String(open));

          toggle?.setAttribute(
            "aria-label",
            open ? "Close navigation menu" : "Open navigation menu",
          );

          mobileNav?.toggleAttribute("inert", !open);

          document.body.classList.toggle("navigation-open", open);
        }

        toggle.addEventListener("click", () => {
          setMenuOpen(!isOpen);
        });

        mobileNav.addEventListener("click", (event) => {
          const target = event.target;

          if (target instanceof Element && target.closest("a")) {
            setMenuOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && isOpen) {
            setMenuOpen(false);
            toggle.focus();
          }
        });

        desktopQuery.addEventListener("change", (event) => {
          if (event.matches) {
            setMenuOpen(false);
          }
        });

        document.addEventListener("click", (event) => {
          if (
            isOpen &&
            event.target instanceof Node &&
            !header.contains(event.target)
          ) {
            setMenuOpen(false);
          }
        });

        /* Header scroll state */

        function updateHeader() {
          header?.classList.toggle("is-scrolled", window.scrollY > 12);
        }

        updateHeader();

        window.addEventListener("scroll", updateHeader, { passive: true });

        /* Scroll reveal */

        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

        const revealElements =
          document.querySelectorAll<HTMLElement>("[data-reveal]");

        if (!reducedMotion.matches && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries, currentObserver) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.classList.add("is-visible");

                currentObserver.unobserve(entry.target);
              });
            },
            {
              threshold: 0.08,
              rootMargin: "0px 0px -24px 0px",
            },
          );

          revealElements.forEach((element) => {
            const bounds = element.getBoundingClientRect();

            if (bounds.top < window.innerHeight) {
              element.classList.add("is-visible");
            } else {
              element.classList.add("reveal-ready");
              observer.observe(element);
            }
          });
        }
      }

      initializePennedLayout();

      document.addEventListener("astro:page-load", initializePennedLayout);
    </script>
  </body>
</html>

<style>
  /* ========================================================
     HEADER — MOBILE FIRST
     ======================================================== */

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);

    width: 100%;

    background: rgba(0, 0, 0, 0.96);

    border-bottom: 1px solid transparent;

    transition:
      background var(--transition-normal),
      border-color var(--transition-normal);
  }

  .site-header.is-scrolled,
  .site-header.menu-open {
    background: #000000;
    border-bottom-color: var(--border-subtle);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    max-width: var(--container-2xl);

    min-height: 64px;

    margin-inline: auto;
    padding-inline: 16px;

    gap: 16px;
  }

  /* Brand */

  .brand {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    flex-shrink: 0;

    color: #ffffff;
    text-decoration: none;
  }

  .brand:hover {
    color: #ffffff;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    flex-shrink: 0;
  }

  .brand-mark img {
    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-family);
    font-size: 1.5rem;
    font-weight: 900;

    line-height: 1;

    letter-spacing: -0.055em;
  }

  /* Header Actions */

  .header-actions {
    display: flex;
    align-items: center;

    gap: 12px;
  }

  .header-cta {
    display: none;
  }

  /* Mobile Menu Toggle */

  .menu-toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 5px;

    width: 44px;
    height: 44px;

    padding: 10px;

    background: var(--background-card);

    border: 1px solid var(--border-primary);
    border-radius: 14px;

    color: #ffffff;
  }

  .menu-toggle span {
    display: block;

    width: 20px;
    height: 2px;

    background: currentColor;

    border-radius: 999px;

    transition:
      transform 250ms ease,
      opacity 250ms ease;
  }

  .menu-open .menu-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }

  .menu-open .menu-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ========================================================
     MOBILE NAVIGATION
     ======================================================== */

  .mobile-navigation {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;

    display: none;

    max-height: calc(100dvh - 64px);

    overflow-y: auto;
    overscroll-behavior: contain;

    background: #000000;

    border-bottom: 1px solid var(--border-primary);
  }

  .menu-open .mobile-navigation {
    display: block;
  }

  .mobile-navigation-inner {
    display: flex;
    flex-direction: column;

    gap: 4px;

    width: 100%;

    padding: 16px 16px 28px;
  }

  .mobile-link,
  .mobile-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 54px;

    padding: 14px 16px;

    border-radius: 14px;

    color: #ffffff;

    font-size: 1rem;
    font-weight: 900;

    text-decoration: none;
  }

  .mobile-group summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-group summary svg {
    width: 18px;
    height: 18px;

    transition: transform 250ms ease;
  }

  .mobile-group[open] summary svg {
    transform: rotate(180deg);
  }

  .mobile-link.active,
  .mobile-group[open] summary {
    background: var(--background-card);

    color: var(--color-purple-light);
  }

  .mobile-submenu {
    display: flex;
    flex-direction: column;

    gap: 4px;

    padding: 4px 0 12px 16px;
  }

  .mobile-submenu-link {
    display: flex;
    align-items: center;

    min-height: 44px;

    padding: 10px 16px;

    border-radius: 12px;

    color: var(--text-secondary);

    font-size: 0.9375rem;
    font-weight: 900;
  }

  .mobile-submenu-link.active {
    color: var(--color-purple-light);
    background: var(--background-card);
  }

  .mobile-download {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 52px;

    margin-top: 16px;
    padding: 14px 24px;

    background: var(--color-purple-primary);

    border-radius: var(--radius-pill);

    color: #ffffff;

    font-size: 1rem;
    font-weight: 900;
  }

  .mobile-download:hover {
    background: var(--color-purple-light);
    color: #000000;
  }

  :global(body.navigation-open) {
    overflow: hidden;
  }

  /* ========================================================
     DESKTOP NAVIGATION
     ======================================================== */

  .desktop-navigation {
    display: none;
  }

  /* ========================================================
     FOOTER — MOBILE FIRST
     ======================================================== */

  .site-footer {
    width: 100%;

    background: #000000;

    border-top: 1px solid var(--border-subtle);
  }

  .footer-container {
    width: 100%;
    max-width: var(--container-2xl);

    margin-inline: auto;

    padding: 64px 16px 24px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 16px;
  }

  .footer-description {
    color: #ffffff;

    font-size: 1.125rem;
    font-weight: 900;
  }

  .footer-tagline {
    max-width: 320px;

    color: var(--text-secondary);

    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 40px 24px;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-column h2 {
    margin-bottom: 20px;

    color: #ffffff;

    font-size: 1rem;
    font-weight: 900;
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;

    gap: 14px;
  }

  .footer-column a {
    color: var(--text-secondary);

    font-size: 0.875rem;
    font-weight: 900;

    line-height: 1.5;

    transition: color var(--transition-fast);
  }

  .footer-column a:hover {
    color: var(--color-purple-light);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;

    gap: 20px;

    margin-top: 64px;
    padding-top: 24px;

    border-top: 1px solid var(--border-subtle);
  }

  .footer-bottom p {
    color: var(--text-muted);

    font-size: 0.8125rem;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;

    gap: 20px;
  }

  .footer-legal a {
    color: var(--text-secondary);

    font-size: 0.8125rem;
  }

  .footer-legal a:hover {
    color: var(--color-purple-light);
  }

  /* ========================================================
     TABLET — 640px+
     ======================================================== */

  @media (min-width: 640px) {
    .header-container {
      padding-inline: 24px;
    }

    .mobile-navigation-inner {
      padding-inline: 24px;
    }

    .footer-container {
      padding-inline: 24px;
    }

    .footer-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* ========================================================
     TABLET — 768px+
     ======================================================== */

  @media (min-width: 768px) {
    .header-container {
      min-height: 72px;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
    }

    .brand-name {
      font-size: 1.625rem;
    }

    .header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 44px;

      padding: 10px 22px;

      background: var(--color-purple-primary);

      border-radius: var(--radius-pill);

      color: #ffffff;

      font-size: 0.875rem;
      font-weight: 900;

      transition:
        background var(--transition-normal),
        transform var(--transition-normal);
    }

    .header-cta:hover {
      background: var(--color-purple-light);
      color: #000000;

      transform: translateY(-2px);
    }

    .mobile-navigation {
      max-height: calc(100dvh - 72px);
    }

    .footer-container {
      padding-top: 80px;
      padding-bottom: 32px;
    }

    .footer-top {
      gap: 64px;
    }
  }

  /* ========================================================
     DESKTOP — 1024px+
     ======================================================== */

  @media (min-width: 1024px) {
    .header-container {
      min-height: 80px;

      padding-inline: 32px;
    }

    .desktop-navigation {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin-inline: auto;
    }

    .nav-dropdown {
      position: relative;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;

      gap: 6px;

      min-height: 44px;

      padding: 10px 14px;

      border-radius: 12px;

      color: var(--text-secondary);

      font-size: 0.875rem;
      font-weight: 900;

      white-space: nowrap;

      transition:
        color var(--transition-fast),
        background var(--transition-fast);
    }

    .nav-link svg {
      width: 15px;
      height: 15px;

      transition: transform var(--transition-normal);
    }

    .nav-link:hover,
    .nav-link.active,
    .nav-dropdown:focus-within > .nav-link {
      color: #ffffff;
      background: var(--background-card);
    }

    .nav-dropdown:hover .nav-link svg,
    .nav-dropdown:focus-within .nav-link svg {
      transform: rotate(180deg);
    }

    .dropdown-panel {
      position: absolute;
      top: calc(100% + 8px);
