---
import ReaderIcon from "./ReaderIcon.astro";
interface Props { password: boolean; email: boolean; token: string }
const { password, email, token }=Astro.props;
---
<main class="reader-state reader-gate" id="document">
  <ReaderIcon name="lockwavy" />
  <h1>Protected Document</h1>
  <form method="post" data-reader-gate data-token={token}>
    {password&&<label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="256" /></label>}
    {email&&<>
      <label>Email<input type="email" name="email" autocomplete="email" required maxlength="254" /></label>
      <button type="button" data-send-code>Send Verification Code</button>
      <label>Verification Code<input type="text" name="code" autocomplete="one-time-code" inputmode="numeric" maxlength="12" /></label>
    </>}
    <p data-gate-message role="status" hidden></p>
    <button type="submit">Open Document</button>
  </form>
</main>
